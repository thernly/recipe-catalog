{
  "permissions": {
    "allow": [
      "Bash(uv sync:*)",
      "Bash(git add:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run pytest:*)",
      "Bash(npm run build:*)",
      "Skill(frontend-design:frontend-design)",
      "Bash(cat:*)",
      "Bash(npm run check:*)",
      "Bash(git *)",
      "Bash(pnpm test *)",
      "Bash(gh pr *)"
    ],
    "deny": [],
    "ask": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-shell-edits.py\"",
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
